{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure            {:mvn/version "1.12.5"}
  babashka/fs                    {:mvn/version "0.5.34"}
  buddy/buddy-hashers            {:mvn/version "2.0.167"}
  clojure.java-time/clojure.java-time {:mvn/version "1.4.3"}
  com.taoensso/telemere          {:mvn/version "1.4.0"}
  com.cnuernber/charred          {:mvn/version "1.042"}
  environ/environ                {:mvn/version "1.2.0"}
  io.github.nextjournal/markdown {:mvn/version "0.7.225"}
  ring/ring-core                 {:mvn/version "1.15.5"}
  ring/ring-devel                {:mvn/version "1.15.5"}
  ring/ring-defaults             {:mvn/version "0.7.1"}
  http-kit/http-kit              {:mvn/version "2.9.0-beta4"}
  metosin/reitit-ring            {:mvn/version "0.10.1"}
  hiccup/hiccup                  {:mvn/version "2.0.0"}
  timeout-shell/timeout-shell    {:mvn/version "1.0.0"}
  ;
  io.github.hkimjp/datascript-storage-javatime {:git/tag "0.7.10" :git/sha "f21800d"}
  io.github.hkimjp/carmine-farm  {:git/tag "0.5.114" :git/sha "eb8618d"}}

 :aliases
 {:dev {:extra-paths ["dev"]
        :extra-deps  {io.github.tonsky/clj-reload {:mvn/version "1.0.0"}}
        :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                      "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                      "--enable-native-access=ALL-UNNAMED"]}

  ;; clojure -M:nrepl
  ;; Clojure Sublimed can not talk to nrepl > "1.5.2".
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
          :main-opts  ["-m" "nrepl.cmdline"]}

  ;; clolure -X:plus
  :plus {:extra-deps {io.github.tonsky/clojure-plus {:mvn/version "1.7.2"}}
         :exec-fn    clojure+.core.server/start-server
         :exec-args  {:name "socket repl(plus)"}}

  :run-m {:main-opts ["-m" "hkimjp.jpy.main"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}

  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}

  :neil {:project {:name hkimjp/jpy}}}}
