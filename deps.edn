{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure            {:mvn/version "1.12.4"}
  babashka/fs                    {:mvn/version "0.5.32"}
  buddy/buddy-hashers            {:mvn/version "2.0.167"}
  clojure.java-time/clojure.java-time {:mvn/version "1.4.3"}
  com.taoensso/telemere          {:mvn/version "1.2.1"}
  com.cnuernber/charred          {:mvn/version "1.038"}
  environ/environ                {:mvn/version "1.2.0"}
  ;; io.github.nextjournal/markdown {:mvn/version "0.7.196"}
  ring/ring-core                 {:mvn/version "1.15.3"}
  ring/ring-devel                {:mvn/version "1.15.3"}
  ring/ring-defaults             {:mvn/version "0.7.0"}
  http-kit/http-kit              {:mvn/version "2.9.0-beta3"}
  metosin/reitit-ring            {:mvn/version "0.10.1"}
  hiccup/hiccup                  {:mvn/version "2.0.0"}
  timeout-shell/timeout-shell    {:mvn/version "1.0.0"}
  io.github.hkimjp/datascript-storage-javatime {:git/tag "0.7.8" :git/sha "aad430b"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]
   :extra-deps  {io.github.tonsky/clj-reload {:mvn/version "1.0.0"}}
   :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                 "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                 "--enable-native-access=ALL-UNNAMED"]}

  ;;clojure -M:nrepl
  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.5.2"}} ; 1.5.2 is OK, 1.6.0 NOT.
   :main-opts  ["-m" "nrepl.cmdline"]}

  ;; clolure -X:plus
  :plus
  {:extra-deps {io.github.tonsky/clojure-plus {:mvn/version "1.7.2"}}
   :exec-fn    clojure+.core.server/start-server
   :exec-args  {:name "socket repl(plus)"}}

  :run-m
  {:main-opts ["-m" "hkimjp.jpy.main"]}

  ; :run-x
  ; {:ns-default hkimjp.jpy
  ;  :exec-fn greet
  ;  :exec-args {:name "Clojure"}}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.13"}}
   :ns-default build}

  :test
  {:extra-paths ["test"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}

  :neil
  {:project {:name hkimjp/scratch}}}}
